# Server configuration
PORT=5000
NODE_ENV=development
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=7d

# Main RPM Database Configuration (Read-Only)
MAIN_DB_HOST=127.0.0.1
MAIN_DB_PORT=5432
MAIN_DB_NAME=backup_2_july
MAIN_DB_USER=postgres
MAIN_DB_PASSWORD=postgres

# Chatbot Database Configuration (Read-Write)
CHATBOT_DB_HOST=127.0.0.1
CHATBOT_DB_PORT=5432
CHATBOT_DB_NAME=chatbot_db
CHATBOT_DB_USER=postgres
CHATBOT_DB_PASSWORD=postgres

# Gemini API Configuration
GEMINI_API_KEY=your_gemini_api_key_here

# AWS Configuration (S3 for RAG Documents)
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_REGION=us-east-1
AWS_S3_BUCKET=rehab-chatbot-documents
